generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model User {
  id                  String      @id @default(cuid())
  name                String
  email               String      @unique
  emailVerified       DateTime?
  image               String?
  role                UserRole    @default(viewer)
  department          String?
  title               String?
  isActive            Boolean     @default(true)
  lastLoginAt         DateTime?
  createdAt           DateTime    @default(now())
  updatedAt           DateTime    @updatedAt
  failedLoginAttempts Int         @default(0)
  mustChangePassword  Boolean     @default(true)
  passwordHash        String?
  tokens              UserToken[]
  accounts            Account[]
  auditLogs           AuditLog[]
  sessions            Session[]

  @@map("users")
}

model UserToken {
  id          String        @id @default(cuid())
  userId      String
  type        UserTokenType
  hashedToken String
  expiresAt   DateTime
  usedAt      DateTime?
  createdAt   DateTime      @default(now())
  user        User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([hashedToken])
  @@index([type])
}

model Entity {
  id                    String                 @id @default(cuid())
  name                  String
  country               String
  legalStructure        String
  registrationNumber    String
  registeredAddress     String?
  incorporationDate     DateTime
  financialYearEnd      String
  governingLaw          String?
  auditor               String?
  regulator             String?
  status                EntityStatus           @default(active)
  notes                 String?
  parentEntityId        String?
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  formerName            String?
  healthScore           Int?
  purpose               String?
  regulatorUrl          String?
  isLegacyEntity        Boolean                @default(false) @map("isIxarisEntity")
  torSettings           Json?
  alerts                Alert[]
  auditLogs             AuditLog[]
  bankAccounts          BankAccount[]
  boardMeetings         BoardMeeting[]
  complianceObligations ComplianceObligation[]
  directors             Director[]
  documents             Document[]
  parent                Entity?                @relation("EntityHierarchy", fields: [parentEntityId], references: [id])
  subsidiaries          Entity[]               @relation("EntityHierarchy")
  licenses              License[]
  regulatoryCapital     RegulatoryCapital?

  @@index([country])
  @@index([status])
  @@index([parentEntityId])
  @@map("entities")
}

model Director {
  id               String            @id @default(cuid())
  entityId         String
  name             String
  email            String?
  role             String
  appointmentDate  DateTime?
  termExpiry       DateTime?
  nationality      String?
  isActive         Boolean           @default(true)
  notes            String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  guideUrl         String?
  remuneration     String?
  responsibilities String?
  entity           Entity            @relation(fields: [entityId], references: [id], onDelete: Cascade)
  meetingAttendees MeetingAttendee[]

  @@index([entityId])
  @@index([email])
  @@map("directors")
}

model BoardMeeting {
  id               String              @id @default(cuid())
  entityId         String
  meetingType      String
  meetingDate      DateTime
  meetingTime      String
  timezone         String              @default("UTC")
  locationType     MeetingLocationType @default(physical)
  location         String?
  virtualLink      String?
  agenda           String
  chair            String
  quorumRequired   Int                 @default(3)
  status           MeetingStatus       @default(scheduled)
  minutes          String?
  notes            String?
  recurrence       String?
  heldAt           DateTime?
  confirmedBy      String?
  directorsPresent Int?
  minutesUrl       String?
  createdBy        String
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  entity           Entity              @relation(fields: [entityId], references: [id], onDelete: Cascade)
  attendees        MeetingAttendee[]
  documents        MeetingDocument[]
  resolutions      MeetingResolution[]

  @@index([entityId])
  @@index([meetingDate])
  @@index([status])
  @@map("board_meetings")
}

model MeetingAttendee {
  id          String         @id @default(cuid())
  meetingId   String
  directorId  String
  status      AttendeeStatus @default(invited)
  invitedAt   DateTime       @default(now())
  respondedAt DateTime?
  director    Director       @relation(fields: [directorId], references: [id], onDelete: Cascade)
  meeting     BoardMeeting   @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@unique([meetingId, directorId])
  @@map("meeting_attendees")
}

model MeetingDocument {
  id         String       @id @default(cuid())
  meetingId  String
  name       String
  fileType   String
  fileSize   Int
  uploadedBy String
  uploadedAt DateTime     @default(now())
  category   String
  storageUrl String?
  meeting    BoardMeeting @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_documents")
}

model MeetingResolution {
  id           String           @id @default(cuid())
  meetingId    String
  title        String
  description  String
  proposedBy   String
  votesFor     Int              @default(0)
  votesAgainst Int              @default(0)
  votesAbstain Int              @default(0)
  status       ResolutionStatus @default(proposed)
  notes        String?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  meeting      BoardMeeting     @relation(fields: [meetingId], references: [id], onDelete: Cascade)

  @@index([meetingId])
  @@map("meeting_resolutions")
}

model ComplianceObligation {
  id              String           @id @default(cuid())
  entityId        String
  requirementType String
  regulator       String
  description     String
  dueDate         DateTime
  submittedDate   DateTime?
  status          ComplianceStatus @default(pending)
  owner           String
  notes           String?
  recurrence      String           @default("annual")
  filingReference String?
  confirmedBy     String?
  completedAt     DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  calendarYear    Int?
  source          String           @default("manual")
  jiraReference   String?          @map("jira_reference")
  entity          Entity           @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([dueDate])
  @@index([status])
  @@map("compliance_obligations")
}

model License {
  id              String        @id @default(cuid())
  entityId        String
  licenseType     String
  regulator       String
  licenseNumber   String
  issueDate       DateTime?
  expiryDate      DateTime?
  renewalRequired Boolean       @default(true)
  renewalLeadDays Int           @default(90)
  status          LicenseStatus @default(active)
  documentUrl     String?
  notes           String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  entity          Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([expiryDate])
  @@index([status])
  @@map("licenses")
}

model RegulatoryCapital {
  id                 String   @id @default(cuid())
  entityId           String   @unique
  capitalRequirement String
  currency           String   @default("USD")
  minimumRequired    Float
  currentBalance     Float
  bufferPercentage   Float    @default(20)
  notes              String?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  entity             Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@map("regulatory_capital")
}

model BankAccount {
  id                 String   @id @default(cuid())
  entityId           String
  bankName           String
  accountNumber      String
  currency           String
  balance            Float    @default(0)
  minRequiredBalance Float    @default(0)
  notes              String?
  lastUpdated        DateTime @default(now())
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
  entity             Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@map("bank_accounts")
}

model Alert {
  id        String        @id @default(cuid())
  entityId  String
  title     String
  message   String
  severity  AlertSeverity @default(info)
  status    AlertStatus   @default(unread)
  category  String
  relatedId String?
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  entity    Entity        @relation(fields: [entityId], references: [id], onDelete: Cascade)

  @@index([entityId])
  @@index([status])
  @@index([severity])
  @@map("alerts")
}

model Document {
  id         String   @id @default(cuid())
  entityId   String
  name       String
  category   String
  fileType   String
  fileSize   Int
  uploadedBy String
  storageUrl String?
  version    Int      @default(1)
  tags       String[]
  notes      String?
  uploadedAt DateTime @default(now())
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  fileName   String?  @map("file_name")
  entity     Entity   @relation(fields: [entityId], references: [id], onDelete: Cascade)

  deletedAt DateTime?
  deletedBy String?

  @@index([entityId])
  @@index([category])
  @@map("documents")
}

model AuditLog {
  id        String      @id @default(cuid())
  entityId  String?
  userId    String?
  action    AuditAction
  tableName String
  recordId  String
  oldValues Json?
  newValues Json?
  ipAddress String?
  userAgent String?
  notes     String?
  createdAt DateTime    @default(now())
  entity    Entity?     @relation(fields: [entityId], references: [id])
  user      User?       @relation(fields: [userId], references: [id])

  @@index([entityId])
  @@index([userId])
  @@index([tableName, recordId])
  @@index([createdAt])
  @@map("audit_logs")
}

model Submission {
  id                 String           @id @default(cuid())
  type               SubmissionType
  title              String
  description        String
  pageUrl            String?
  component          String?
  severity           String?
  area               String?
  priority           String?
  submittedBy        String
  status             SubmissionStatus @default(open)
  prdContent         String?
  prdGeneratedAt     DateTime?
  slackMessageTs     String?
  approvedBy         String?
  approvedAt         DateTime?
  rejectedBy         String?
  rejectedAt         DateTime?
  rejectionNote      String?
  implementedAt      DateTime?
  implementationNote String?
  createdAt          DateTime         @default(now())
  updatedAt          DateTime         @updatedAt

  @@index([status])
  @@index([type])
  @@index([submittedBy])
  @@map("submissions")
}

enum EntityStatus {
  active
  dormant
  dissolved
  in_formation
}

enum ComplianceStatus {
  pending
  submitted
  overdue
  completed
  not_applicable
}

enum LicenseStatus {
  active
  expired
  suspended
  pending_renewal
}

enum AlertSeverity {
  critical
  warning
  info
}

enum AlertStatus {
  unread
  read
  dismissed
}

enum MeetingStatus {
  draft
  scheduled
  completed
  cancelled
}

enum MeetingLocationType {
  physical
  virtual
  hybrid
}

enum AttendeeStatus {
  invited
  accepted
  declined
  tentative
}

enum ResolutionStatus {
  proposed
  passed
  defeated
  deferred
}

enum UserRole {
  super_admin
  admin
  legal
  finance
  viewer
}

enum UserTokenType {
  INVITATION
  PASSWORD_RESET
  EMAIL_VERIFICATION
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  INVITE
  DEACTIVATE
  REACTIVATE
}

enum SubmissionType {
  bug
  feature
}

enum SubmissionStatus {
  open
  in_review
  approved
  implementing
  done
  rejected
}
